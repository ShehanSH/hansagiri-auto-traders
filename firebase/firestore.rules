rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminData().active != false
        && adminData().role in ['super_admin', 'admin', 'sales'];
    }

    function isFullAdmin() {
      return isAdmin() && adminData().role in ['super_admin', 'admin'];
    }

    function isSuperAdmin() {
      return isAdmin() && adminData().role == 'super_admin';
    }

    function validString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /vehicles/{id} {
      allow read: if resource.data.status in ['available', 'reserved', 'sold'] || isAdmin();
      allow create, update, delete: if isFullAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    match /inquiries/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.phone, 20)
        && validString(request.resource.data.message, 2000)
        && request.resource.data.keys().hasAny(['name', 'phone', 'message']);
      allow read, update, delete: if isAdmin();
    }

    match /testDrives/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.phone, 20)
        && validString(request.resource.data.preferredDate, 40);
      allow read, update, delete: if isAdmin();
    }

    match /tradeIns/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.phone, 20)
        && validString(request.resource.data.make, 40);
      allow read, update, delete: if isFullAdmin() || isAdmin();
    }

    match /contactMessages/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.message, 2000);
      allow read, update, delete: if isFullAdmin();
    }

    match /financingInquiries/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.phone, 20);
      allow read, update, delete: if isAdmin();
    }

    match /customers/{id} {
      allow create: if validString(request.resource.data.name, 80)
        && validString(request.resource.data.phone, 20);
      allow update: if isAdmin() || (
        !signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'phone',
            'email',
            'whatsapp',
            'interestedVehicles',
            'inquiryIds',
            'testDriveIds',
            'tradeInIds',
            'updatedAt',
            'lastContact',
            'status',
            'createdAt',
          ])
      );
      allow read, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isSuperAdmin();
    }

    match /activityLogs/{id} {
      allow read: if isFullAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /media/{id} {
      allow read, write: if isFullAdmin();
    }
  }
}
